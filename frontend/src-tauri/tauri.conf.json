{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FantasyHubFrontend",
  "mainBinaryName": "FantasyHubFrontend",
  "version": "0.1.58",
  "identifier": "com.handheld.frontend",
  "build": {
    "devUrl": "http://localhost:1420/frontend.html",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "../../src-tauri/icons/32x32.png",
      "../../src-tauri/icons/128x128.png",
      "../../src-tauri/icons/128x128@2x.png",
      "../../src-tauri/icons/icon.icns",
      "../../src-tauri/icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis/installer.nsh"
      }
    }
  }
}
