{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FantasyHubFrontend",
  "mainBinaryName": "FantasyHubFrontend",
  "version": "0.1.48",
  "identifier": "com.handheld.frontend",
  "build": {
    "devUrl": "http://localhost:1420/frontend.html",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "幻想前端",
        "url": "frontend.html",
        "width": 440,
        "height": 800,
        "resizable": false,
        "decorations": false,
        "visible": false,
        "focus": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "../../src-tauri/icons/32x32.png",
      "../../src-tauri/icons/128x128.png",
      "../../src-tauri/icons/128x128@2x.png",
      "../../src-tauri/icons/icon.icns",
      "../../src-tauri/icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis/installer.nsh"
      }
    }
  }
}
