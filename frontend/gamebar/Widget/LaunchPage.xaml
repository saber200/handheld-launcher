<Page
    x:Class="FantasyHub.GameBar.LaunchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Background="#172030">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="28" Spacing="20" MaxWidth="640" HorizontalAlignment="Center">
            <TextBlock Text="FantasyHub · Xbox Game Bar" FontSize="26" TextWrapping="Wrap" />
            <ComboBox x:Name="LanguageBox" SelectionChanged="LanguageChanged"
                      AutomationProperties.Name="Language / 语言" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="简体中文" />
                <ComboBoxItem Content="English" />
            </ComboBox>
            <TextBlock x:Name="GuideText" TextWrapping="Wrap" FontSize="18" />
        </StackPanel>
    </ScrollViewer>
</Page>