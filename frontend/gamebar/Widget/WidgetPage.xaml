<Page x:Class="FantasyHub.GameBar.WidgetPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 XYFocusKeyboardNavigation="Enabled">
 <!-- 视觉对齐原前端：颜色/圆角/字号照 src/styles/global.css 的 :root 变量换算，
      rgba() 在这里写成 #AARRGGBB —— UWP 的 8 位十六进制是 ARGB，不是 RGBA。 -->
 <Page.Resources>
  <SolidColorBrush x:Key="FhInk" Color="#F3F6FB" />
  <SolidColorBrush x:Key="FhMuted" Color="#9AA8BD" />
  <SolidColorBrush x:Key="FhLine" Color="#1AFFFFFF" />
  <SolidColorBrush x:Key="FhCard" Color="#0AFFFFFF" />
  <SolidColorBrush x:Key="FhDanger" Color="#FF6B7A" />
  <SolidColorBrush x:Key="FhAccent" Color="#3DD6C6" />

  <!-- 预设按钮 = 原前端的 .tdp-preset / .tdp-preset.on：底 rgba(0,0,0,.2)，
       选中整块 accent 填充 + 深字 #06241f。覆盖 ToggleButton 的主题资源键就够；
       键名写错只是不生效，不会让 XAML 解析失败，所以这里可以放心铺开写。 -->
  <SolidColorBrush x:Key="ToggleButtonBackground" Color="#33000000" />
  <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#4D000000" />
  <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#66000000" />
  <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="#1A000000" />
  <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#3DD6C6" />
  <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#55E2D4" />
  <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#2FC2B4" />
  <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedDisabled" Color="#333DD6C6" />
  <SolidColorBrush x:Key="ToggleButtonForeground" Color="#F3F6FB" />
  <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ToggleButtonForegroundPressed" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ToggleButtonForegroundDisabled" Color="#66F3F6FB" />
  <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#06241F" />
  <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#06241F" />
  <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#06241F" />
  <SolidColorBrush x:Key="ToggleButtonForegroundCheckedDisabled" Color="#6606241F" />
  <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="#1AFFFFFF" />
  <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="#33FFFFFF" />
  <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="#33FFFFFF" />
  <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled" Color="#0FFFFFFF" />
  <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
  <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
  <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />
  <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedDisabled" Color="Transparent" />
  <!-- 滑块：等价于原前端的 accent-color: accent 变量 -->
  <SolidColorBrush x:Key="SliderTrackFill" Color="#28FFFFFF" />
  <SolidColorBrush x:Key="SliderTrackValueFill" Color="#3DD6C6" />
  <SolidColorBrush x:Key="SliderThumbBackground" Color="#3DD6C6" />
  <SolidColorBrush x:Key="SliderTrackFillDisabled" Color="#14FFFFFF" />
  <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="#553DD6C6" />
  <SolidColorBrush x:Key="SliderThumbBackgroundDisabled" Color="#4D9AA8BD" />
  <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#3DD6C6" />
  <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#3DD6C6" />
  <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#55E2D4" />
  <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#2FC2B4" />
  <!-- 卡片：.tdp-panel / .setting-row / .toolbox-block 的公共外观（圆角 16、1px 白 10%） -->
  <Style x:Key="FhCardStyle" TargetType="Border">
   <Setter Property="Padding" Value="16,18" />
   <Setter Property="CornerRadius" Value="16" />
   <Setter Property="BorderThickness" Value="1" />
   <Setter Property="BorderBrush" Value="{StaticResource FhLine}" />
   <Setter Property="Background" Value="{StaticResource FhCard}" />
  </Style>

  <!-- 头部胶囊按钮：.library-tool（accent 描边 + 8% accent 底） -->
  <Style x:Key="FhToolButton" TargetType="Button">
   <Setter Property="Padding" Value="14,8" />
   <Setter Property="CornerRadius" Value="999" />
   <Setter Property="BorderThickness" Value="1" />
   <Setter Property="BorderBrush" Value="#663DD6C6" />
   <Setter Property="Background" Value="#143DD6C6" />
   <Setter Property="Foreground" Value="{StaticResource FhAccent}" />
   <Setter Property="FontSize" Value="14" />
   <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- 设置行：.setting-row（整块可点、内容左对齐） -->
  <Style x:Key="FhRowButton" TargetType="Button">
   <Setter Property="Padding" Value="18,16" />
   <Setter Property="CornerRadius" Value="16" />
   <Setter Property="BorderThickness" Value="1" />
   <Setter Property="BorderBrush" Value="{StaticResource FhLine}" />
   <Setter Property="Background" Value="{StaticResource FhCard}" />
   <Setter Property="Foreground" Value="{StaticResource FhInk}" />
   <Setter Property="FontSize" Value="16" />
   <Setter Property="FontWeight" Value="SemiBold" />
   <Setter Property="HorizontalAlignment" Value="Stretch" />
   <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>

  <!-- 预设的 GridViewItem：只做 3 列排版，hover/选中视觉全交给里面的 ToggleButton，
       否则 GridViewItem 会自己画一层系统高亮盖住按钮。 -->
  <Style x:Key="FhPresetItem" TargetType="GridViewItem">
   <Setter Property="Padding" Value="0" />
   <Setter Property="Margin" Value="0" />
   <Setter Property="MinWidth" Value="0" />
   <Setter Property="MinHeight" Value="0" />
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="GridViewItem">
      <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Page.Resources>
 <Grid>
  <Grid.Background>
   <!-- 原前端 .ambient 的 linear-gradient(160deg, bg0, bg1 55%, #0a101b) -->
   <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#0B1220" Offset="0" />
    <GradientStop Color="#121C2E" Offset="0.55" />
    <GradientStop Color="#0A101B" Offset="1" />
   </LinearGradientBrush>
  </Grid.Background>
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto" />
   <RowDefinition Height="*" />
   <RowDefinition Height="Auto" />
  </Grid.RowDefinitions>

  <!-- 头部 = .frontend-shell-head：28px 标题 + 右侧胶囊按钮 -->
  <Grid Padding="20,20,20,8" ColumnSpacing="10">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*" />
    <ColumnDefinition Width="Auto" />
   </Grid.ColumnDefinitions>
   <TextBlock Text="FantasyHub" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource FhInk}"
     TextWrapping="Wrap" VerticalAlignment="Center" />
   <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
    <Button x:Name="RefreshButton" Click="RefreshClick" Style="{StaticResource FhToolButton}" />
    <Button x:Name="CloseButton" Click="CloseClick" Style="{StaticResource FhToolButton}" />
   </StackPanel>
  </Grid>

  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
    Padding="20,4,20,12">
   <StackPanel x:Name="Panel" Spacing="12">
    <!-- TDP 卡片：.tdp-panel -->
    <Border Style="{StaticResource FhCardStyle}">
     <StackPanel Spacing="10">
      <Grid>
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
       </Grid.ColumnDefinitions>
       <TextBlock x:Name="PowerTitle" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource FhInk}"
         TextWrapping="Wrap" VerticalAlignment="Center" />
       <TextBlock x:Name="WattsText" Grid.Column="1" FontSize="22" FontWeight="Bold"
         Foreground="{StaticResource FhAccent}" Text="— W" VerticalAlignment="Center" />
      </Grid>
      <TextBlock x:Name="DeviceText" FontSize="12" Foreground="{StaticResource FhMuted}" TextWrapping="Wrap" />
      <GridView x:Name="Presets" IsEnabled="False" SelectionMode="None" IsItemClickEnabled="False"
        IsTabStop="False" ItemContainerStyle="{StaticResource FhPresetItem}" HorizontalAlignment="Stretch"
        ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
       <GridView.ItemsPanel>
        <ItemsPanelTemplate>
         <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" />
        </ItemsPanelTemplate>
       </GridView.ItemsPanel>
       <GridView.ItemTemplate>
        <DataTemplate>
         <!-- 预设按钮 = .tdp-preset：选中态靠 ToggleButton 的主题资源变成 accent 底 + 深字；
              IsChecked 单向绑 On，点击后的真实状态由 code-behind 写回。 -->
         <ToggleButton IsChecked="{Binding On, Mode=OneWay}" Click="PresetToggleClick" Margin="0,0,8,8"
           MinWidth="0" MinHeight="44" Padding="4" CornerRadius="12" BorderThickness="1" FontSize="16"
           FontWeight="SemiBold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
          <TextBlock Text="{Binding Label}" />
         </ToggleButton>
        </DataTemplate>
       </GridView.ItemTemplate>
      </GridView>
      <Slider x:Name="TdpSlider" IsEnabled="False" Minimum="5" Maximum="40" StepFrequency="1" TickFrequency="1"
        ValueChanged="SliderChanged" Margin="0,2,0,0" />
      <TextBlock x:Name="RangeText" FontSize="12" Foreground="{StaticResource FhMuted}"
        HorizontalAlignment="Right" />
      <TextBlock x:Name="StatusText" FontSize="13" Foreground="{StaticResource FhMuted}" TextWrapping="Wrap"
        IsTextSelectionEnabled="True" AutomationProperties.LiveSetting="Polite" />
      <TextBlock x:Name="OperationText" FontSize="13" Foreground="{StaticResource FhAccent}" TextWrapping="Wrap"
        IsTextSelectionEnabled="True" AutomationProperties.LiveSetting="Polite" />
      <TextBlock x:Name="DriverText" FontSize="13" Foreground="{StaticResource FhMuted}" TextWrapping="Wrap" />
     </StackPanel>
    </Border>
    <TextBlock x:Name="DriverHelpText" FontSize="12" Foreground="{StaticResource FhMuted}" Opacity="0.75"
      TextWrapping="Wrap" />

    <!-- 设置行：风扇（暂不可用）、运行中的游戏 + 退出、自启意图 -->
    <Button x:Name="FanButton" IsEnabled="False" Style="{StaticResource FhRowButton}" />
    <Border Style="{StaticResource FhCardStyle}">
     <StackPanel Spacing="10">
      <TextBlock x:Name="GamesText" FontSize="13" Foreground="{StaticResource FhMuted}" TextWrapping="Wrap" />
      <ComboBox x:Name="GamesBox" HorizontalAlignment="Stretch" />
      <Button x:Name="QuitButton" Click="QuitClick" IsEnabled="False" Style="{StaticResource FhRowButton}"
        Foreground="{StaticResource FhDanger}" />
     </StackPanel>
    </Border>
    <Border Style="{StaticResource FhCardStyle}">
     <StackPanel Spacing="10">
      <Button x:Name="StartupButton" Click="StartupClick" Style="{StaticResource FhRowButton}" />
      <TextBlock x:Name="StartupText" FontSize="12" Foreground="{StaticResource FhMuted}" Opacity="0.75"
        TextWrapping="Wrap" />
     </StackPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>

  <!-- 底部 = .frontend-shell-hint：操作提示 + 语言（次要设置压到最后） -->
  <StackPanel Grid.Row="2" Padding="20,8,20,16" Spacing="10">
   <TextBlock x:Name="HelpText" FontSize="12" Foreground="{StaticResource FhMuted}" Opacity="0.7"
     TextWrapping="Wrap" />
   <ComboBox x:Name="LanguageBox" SelectionChanged="LanguageChanged" HorizontalAlignment="Left"
     MinWidth="180">
    <ComboBoxItem Content="简体中文" Tag="zh-CN" />
    <ComboBoxItem Content="English" Tag="en-US" />
   </ComboBox>
  </StackPanel>
  <MediaElement x:Name="Sound" Grid.Row="2" AutoPlay="False" Volume="0.5" Height="0" Width="0"
    HorizontalAlignment="Left" VerticalAlignment="Bottom" />
 </Grid>
</Page>