<Page x:Class="FantasyHub.GameBar.WidgetPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 XYFocusKeyboardNavigation="Enabled">
 <!-- 视觉对齐原前端：颜色/圆角/字号照 src/styles/global.css 的 :root 变量换算，
      rgba() 在这里写成 #AARRGGBB —— UWP 的 8 位十六进制是 ARGB，不是 RGBA。 -->
 <Page.Resources>
  <SolidColorBrush x:Key="FhInk" Color="#F3F6FB" />
  <SolidColorBrush x:Key="FhMuted" Color="#9AA8BD" />
  <SolidColorBrush x:Key="FhLine" Color="#1AFFFFFF" />
  <SolidColorBrush x:Key="FhCard" Color="#0AFFFFFF" />
  <SolidColorBrush x:Key="FhDanger" Color="#FF6B7A" />
  <SolidColorBrush x:Key="FhAccent" Color="#3DD6C6" />

  <!-- 预设按钮 = 原前端的 .tdp-preset / .tdp-preset.on：底 rgba(0,0,0,.2)，
       选中整块 accent 填充 + 深字 #06241f。覆盖 ToggleButton 的主题资源键就够；
       键名写错只是不生效，不会让 XAML 解析失败，所以这里可以放心铺开写。 -->
  <SolidColorBrush x:Key="ToggleButtonBackground" Color="#33000000" />
  <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#4D000000" />
  <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#66000000" />
  <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="#1A000000" />
  <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#3DD6C6" />
  <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#55E2D4" />
  <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#2FC2B4" />
  <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedDisabled" Color="#333DD6C6" />
  <SolidColorBrush x:Key="ToggleButtonForeground" Color="#F3F6FB" />
  <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ToggleButtonForegroundPressed" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ToggleButtonForegroundDisabled" Color="#66F3F6FB" />
  <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#06241F" />
  <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#06241F" />
  <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#06241F" />
  <SolidColorBrush x:Key="ToggleButtonForegroundCheckedDisabled" Color="#6606241F" />
  <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="#1AFFFFFF" />
  <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="#33FFFFFF" />
  <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="#33FFFFFF" />
  <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled" Color="#0FFFFFFF" />
  <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
  <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
  <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />
  <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedDisabled" Color="Transparent" />

  <!-- Button 的主题键：UWP 默认模板的 hover / pressed / disabled 状态是用这些键直接刷
       ContentPresenter 的 Background / BorderBrush / Foreground，Style 里设的值会被盖掉。
       真机上「风扇控制 · 暂未开放」一被禁用就变成一条发亮的灰条、字几乎看不见，就是这里。
       统一收进深色系：hover/pressed 用白色低透明度，禁用态用「同底色 + 半透明字」，
       不再让系统那套浅灰漏出来。 -->
  <SolidColorBrush x:Key="ButtonBackground" Color="#0AFFFFFF" />
  <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#14FFFFFF" />
  <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#24FFFFFF" />
  <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#0AFFFFFF" />
  <SolidColorBrush x:Key="ButtonForeground" Color="#F3F6FB" />
  <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#66F3F6FB" />
  <SolidColorBrush x:Key="ButtonBorderBrush" Color="#1AFFFFFF" />
  <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#33FFFFFF" />
  <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#33FFFFFF" />
  <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#0FFFFFFF" />

  <!-- 下拉框（运行中的游戏 / 语言）：默认外观在这套深色板里一眼就是系统控件，统一成卡片同款。
       键名写错只是不生效，不会让编译失败。 -->
  <SolidColorBrush x:Key="ComboBoxBackground" Color="#0AFFFFFF" />
  <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#14FFFFFF" />
  <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#1FFFFFFF" />
  <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#08000000" />
  <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#1AFFFFFF" />
  <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#33FFFFFF" />
  <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#33FFFFFF" />
  <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="#0FFFFFFF" />
  <SolidColorBrush x:Key="ComboBoxForeground" Color="#F3F6FB" />
  <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ComboBoxForegroundPressed" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="#66F3F6FB" />
  <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#121C2E" />
  <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#1AFFFFFF" />

  <!-- 滑块：等价于原前端的 accent-color: accent 变量 -->
  <SolidColorBrush x:Key="SliderTrackFill" Color="#28FFFFFF" />
  <SolidColorBrush x:Key="SliderTrackValueFill" Color="#3DD6C6" />
  <SolidColorBrush x:Key="SliderThumbBackground" Color="#3DD6C6" />
  <SolidColorBrush x:Key="SliderTrackFillDisabled" Color="#14FFFFFF" />
  <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="#553DD6C6" />
  <SolidColorBrush x:Key="SliderThumbBackgroundDisabled" Color="#4D9AA8BD" />
  <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#3DD6C6" />
  <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#3DD6C6" />
  <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#55E2D4" />
  <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#2FC2B4" />
  <!-- 卡片：.tdp-panel / .setting-row / .toolbox-block 的公共外观（圆角 16、1px 白 10%） -->
  <Style x:Key="FhCardStyle" TargetType="Border">
   <Setter Property="Padding" Value="16,18" />
   <Setter Property="CornerRadius" Value="16" />
   <Setter Property="BorderThickness" Value="1" />
   <Setter Property="BorderBrush" Value="{StaticResource FhLine}" />
   <Setter Property="Background" Value="{StaticResource FhCard}" />
  </Style>

  <!-- 头部按钮：方块 + 小圆角（原前端 .library-tool 的配色，但圆角不跟它走：
       真机上 999 圆角在这块面板里像两个大椭圆，方块看起来才像同一套界面）。
       尺寸按手柄可点标准给：高 44、左右各 16 内边距，字号跟着正文放大到 16。 -->
  <Style x:Key="FhToolButton" TargetType="Button">
   <Setter Property="Padding" Value="16,10" />
   <Setter Property="MinHeight" Value="44" />
   <Setter Property="CornerRadius" Value="10" />
   <Setter Property="BorderThickness" Value="1" />
   <Setter Property="BorderBrush" Value="#663DD6C6" />
   <Setter Property="Background" Value="#143DD6C6" />
   <Setter Property="Foreground" Value="{StaticResource FhAccent}" />
   <Setter Property="FontSize" Value="16" />
   <Setter Property="FontWeight" Value="SemiBold" />
   <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource FhAccent}" />
   <Setter Property="FocusVisualSecondaryBrush" Value="Transparent" />
   <Setter Property="FocusVisualMargin" Value="-2" />
  </Style>

  <!-- 设置行：.setting-row（整块可点、内容左对齐） -->
  <Style x:Key="FhRowButton" TargetType="Button">
   <Setter Property="Padding" Value="18,16" />
   <Setter Property="CornerRadius" Value="16" />
   <Setter Property="BorderThickness" Value="1" />
   <Setter Property="BorderBrush" Value="{StaticResource FhLine}" />
   <Setter Property="Background" Value="{StaticResource FhCard}" />
   <Setter Property="Foreground" Value="{StaticResource FhInk}" />
   <Setter Property="FontSize" Value="16" />
   <Setter Property="FontWeight" Value="SemiBold" />
   <Setter Property="HorizontalAlignment" Value="Stretch" />
   <Setter Property="HorizontalContentAlignment" Value="Left" />
   <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource FhAccent}" />
   <Setter Property="FocusVisualSecondaryBrush" Value="Transparent" />
   <Setter Property="FocusVisualMargin" Value="-2" />
  </Style>

  <!-- 预设按钮 = .tdp-preset：选中态靠覆盖 ToggleButton 的主题资源键变成 accent 底 + 深字。
       焦点视觉改成 accent（原前端 [data-focusable]:focus 就是 accent 描边 + 2px 半透环）——
       不换的话系统默认是白色高对比框，和 checked 的 accent 底同时出现，
       真机上看着像「两个预设同时被选中」。 -->
  <Style x:Key="FhPresetStyle" TargetType="ToggleButton">
   <Setter Property="MinWidth" Value="0" />
   <Setter Property="MinHeight" Value="56" />
   <Setter Property="Padding" Value="8,0" />
   <Setter Property="CornerRadius" Value="14" />
   <Setter Property="BorderThickness" Value="1" />
   <Setter Property="FontSize" Value="18" />
   <Setter Property="FontWeight" Value="SemiBold" />
   <Setter Property="HorizontalAlignment" Value="Stretch" />
   <Setter Property="HorizontalContentAlignment" Value="Center" />
   <Setter Property="VerticalContentAlignment" Value="Center" />
   <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource FhAccent}" />
   <Setter Property="FocusVisualSecondaryBrush" Value="Transparent" />
   <Setter Property="FocusVisualMargin" Value="-2" />
  </Style>

 </Page.Resources>
 <Grid>
  <Grid.Background>
   <!-- 原前端 .ambient 的 linear-gradient(160deg, bg0, bg1 55%, #0a101b) -->
   <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#0B1220" Offset="0" />
    <GradientStop Color="#121C2E" Offset="0.55" />
    <GradientStop Color="#0A101B" Offset="1" />
   </LinearGradientBrush>
  </Grid.Background>
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto" />
   <RowDefinition Height="*" />
   <RowDefinition Height="Auto" />
  </Grid.RowDefinitions>

  <!-- 头部 = .frontend-shell-head：28px 标题 + 右侧胶囊按钮 -->
  <Grid Padding="20,20,20,8" ColumnSpacing="10">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*" />
    <ColumnDefinition Width="Auto" />
   </Grid.ColumnDefinitions>
   <TextBlock Text="FantasyHub" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource FhInk}"
     TextWrapping="Wrap" VerticalAlignment="Center" />
   <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
    <Button x:Name="RefreshButton" Click="RefreshClick" Style="{StaticResource FhToolButton}" />
    <Button x:Name="CloseButton" Click="CloseClick" Style="{StaticResource FhToolButton}" />
   </StackPanel>
  </Grid>

  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
    Padding="20,4,20,12">
   <StackPanel x:Name="Panel" Spacing="12">
    <!-- TDP 卡片：.tdp-panel -->
    <Border Style="{StaticResource FhCardStyle}">
     <StackPanel Spacing="10">
      <Grid>
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
       </Grid.ColumnDefinitions>
       <TextBlock x:Name="PowerTitle" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource FhInk}"
         TextWrapping="Wrap" VerticalAlignment="Center" />
       <TextBlock x:Name="WattsText" Grid.Column="1" FontSize="24" FontWeight="Bold"
         Foreground="{StaticResource FhAccent}" Text="— W" VerticalAlignment="Center" />
      </Grid>
      <TextBlock x:Name="DeviceText" FontSize="13" Foreground="{StaticResource FhMuted}" TextWrapping="Wrap" />
      <!-- 预设不用 GridView：ItemsWrapGrid 给每项的宽度是「集合里最宽那项的期望宽度」，
           不是容器三等分 —— 真机上三个小方块挤在左边、右边空一大片、字还被裁
           （用户反馈「按键贼小、文字显示不全」）。自己铺 3 列 Grid，列宽 = * 才撑得满、
           字号和内边距也才是我们说了算。按钮在 SyncPresets 里生成。
           注意：Grid 是 Panel，**没有 IsEnabled**（那是 Control 上的属性，只有 WPF 把 IsEnabled
           放在 UIElement）—— 写成 IsEnabled="False" 会在 CI 上报 XamlCompiler WMC0011，
           所以「能不能点」逐个落到 ToggleButton 上，外层 Grid 只负责整体变暗。 -->
      <Grid x:Name="PresetGrid" HorizontalAlignment="Stretch" Opacity="0.45" />
      <Slider x:Name="TdpSlider" IsEnabled="False" Minimum="5" Maximum="40" StepFrequency="1" TickFrequency="1"
        ValueChanged="SliderChanged" Margin="0,2,0,0" MinHeight="44"
        FocusVisualPrimaryBrush="{StaticResource FhAccent}" FocusVisualSecondaryBrush="Transparent"
        FocusVisualMargin="-4" />
      <TextBlock x:Name="RangeText" FontSize="13" Foreground="{StaticResource FhMuted}"
        HorizontalAlignment="Right" />
      <TextBlock x:Name="StatusText" FontSize="14" Foreground="{StaticResource FhMuted}" TextWrapping="Wrap"
        IsTextSelectionEnabled="True" AutomationProperties.LiveSetting="Polite" />
      <TextBlock x:Name="OperationText" FontSize="14" Foreground="{StaticResource FhAccent}" TextWrapping="Wrap"
        IsTextSelectionEnabled="True" AutomationProperties.LiveSetting="Polite" />
      <TextBlock x:Name="DriverText" FontSize="14" Foreground="{StaticResource FhMuted}" TextWrapping="Wrap" />
     </StackPanel>
    </Border>
    <!-- 这几行原本额外压了 0.75/0.7 不透明度，比原前端暗一档，真机上灰得看不清，去掉。 -->
    <TextBlock x:Name="DriverHelpText" FontSize="13" Foreground="{StaticResource FhMuted}"
      TextWrapping="Wrap" />

    <!-- 设置行：风扇（暂不可用）、运行中的游戏 + 退出、自启意图 -->
    <Button x:Name="FanButton" IsEnabled="False" Style="{StaticResource FhRowButton}" />
    <Border Style="{StaticResource FhCardStyle}">
     <StackPanel Spacing="10">
      <TextBlock x:Name="GamesText" FontSize="14" Foreground="{StaticResource FhMuted}" TextWrapping="Wrap" />
      <ComboBox x:Name="GamesBox" HorizontalAlignment="Stretch" CornerRadius="10" MinHeight="44" />
      <Button x:Name="QuitButton" Click="QuitClick" IsEnabled="False" Style="{StaticResource FhRowButton}"
        Foreground="{StaticResource FhDanger}" />
     </StackPanel>
    </Border>
    <Border Style="{StaticResource FhCardStyle}">
     <StackPanel Spacing="10">
      <Button x:Name="StartupButton" Click="StartupClick" Style="{StaticResource FhRowButton}" />
      <TextBlock x:Name="StartupText" FontSize="13" Foreground="{StaticResource FhMuted}"
        TextWrapping="Wrap" />
     </StackPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>

  <!-- 底部 = .frontend-shell-hint：操作提示 + 语言（次要设置压到最后） -->
  <StackPanel Grid.Row="2" Padding="20,8,20,16" Spacing="10">
   <TextBlock x:Name="HelpText" FontSize="13" Foreground="{StaticResource FhMuted}"
     TextWrapping="Wrap" />
   <ComboBox x:Name="LanguageBox" SelectionChanged="LanguageChanged" HorizontalAlignment="Left"
     MinWidth="180" MinHeight="44" CornerRadius="10">
    <ComboBoxItem Content="简体中文" Tag="zh-CN" />
    <ComboBoxItem Content="English" Tag="en-US" />
   </ComboBox>
  </StackPanel>
  <MediaElement x:Name="Sound" Grid.Row="2" AutoPlay="False" Volume="0.5" Height="0" Width="0"
    HorizontalAlignment="Left" VerticalAlignment="Bottom" />
 </Grid>
</Page>