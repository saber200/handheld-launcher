<Page x:Class="FantasyHub.GameBar.WidgetPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#172030" XYFocusKeyboardNavigation="Enabled">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel x:Name="Panel" Padding="20" Spacing="12">
   <TextBlock Text="FantasyHub" FontSize="24" FontWeight="SemiBold" />
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Button x:Name="RefreshButton" Click="RefreshClick" HorizontalAlignment="Stretch" Margin="0,0,6,0" />
    <Button x:Name="CloseButton" Grid.Column="1" Click="CloseClick" HorizontalAlignment="Stretch" />
   </Grid>
   <ComboBox x:Name="LanguageBox" Header="语言 / Language" HorizontalAlignment="Stretch" SelectionChanged="LanguageChanged">
    <ComboBoxItem Content="简体中文" Tag="zh-CN" />
    <ComboBoxItem Content="English" Tag="en-US" />
   </ComboBox>
   <TextBlock x:Name="PowerTitle" FontSize="20" FontWeight="SemiBold" />
   <TextBlock x:Name="WattsText" FontSize="28" Text="— W" />
   <TextBlock x:Name="DeviceText" TextWrapping="Wrap" />
   <TextBlock x:Name="DriverText" TextWrapping="Wrap" />
   <TextBlock x:Name="DriverHelpText" TextWrapping="Wrap" Opacity="0.75" />
   <GridView x:Name="Presets" IsItemClickEnabled="True" ItemClick="PresetClick" SelectionMode="Single"
    IsEnabled="False" IsTabStop="False" ScrollViewer.VerticalScrollBarVisibility="Disabled">
    <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate></GridView.ItemsPanel>
    <GridView.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="12,8" /></DataTemplate></GridView.ItemTemplate>
   </GridView>
   <Slider x:Name="TdpSlider" Minimum="5" Maximum="40" StepFrequency="1" TickFrequency="1"
    IsEnabled="False" ValueChanged="SliderChanged" />
   <TextBlock x:Name="RangeText" />
   <TextBlock x:Name="StatusText" TextWrapping="Wrap" IsTextSelectionEnabled="True"
    AutomationProperties.LiveSetting="Polite" />
   <TextBlock x:Name="OperationText" TextWrapping="Wrap" IsTextSelectionEnabled="True"
    AutomationProperties.LiveSetting="Polite" />
   <Button x:Name="FanButton" IsEnabled="False" HorizontalAlignment="Stretch" />
   <TextBlock x:Name="GamesText" TextWrapping="Wrap" />
   <ComboBox x:Name="GamesBox" HorizontalAlignment="Stretch" />
   <Button x:Name="QuitButton" Click="QuitClick" IsEnabled="False" HorizontalAlignment="Stretch" />
   <Button x:Name="StartupButton" Click="StartupClick" HorizontalAlignment="Stretch" />
   <TextBlock x:Name="StartupText" TextWrapping="Wrap" Opacity="0.75" />
   <TextBlock x:Name="HelpText" TextWrapping="Wrap" FontSize="12" Opacity="0.7" />
   <MediaElement x:Name="Sound" AutoPlay="False" Volume="0.5" Height="0" Width="0" />
  </StackPanel>
 </ScrollViewer>
</Page>