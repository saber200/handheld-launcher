{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FantasyHub",
  "mainBinaryName": "FantasyHub",
  "version": "0.1.105",
  "identifier": "com.handheld.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "幻想枢纽",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": true,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPLOCALDATA/**",
          "$RESOURCE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "fse/identity.msix",
      "fse/identity.cer",
      "fse/CustomCapability.SCCD",
      "optiscaler/OptiScaler-custom.7z"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis/installer.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEzNTdEQ0ZEMkIyRjE0OEIKUldTTEZDOHIvZHhYb3l3S1hVZWY5cVFUL3Z1NmZabVk0U0VnOE9YQ3VCOEtVSmNSenFoaTlqR2cK",
      "endpoints": [
        "https://gitee.com/saber200/fantasyhub-releases/releases/download/latest/latest.json",
        "https://github.com/saber200/fantasyhub-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
