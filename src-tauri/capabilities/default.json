{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for FantasyHub",
  "windows": ["main", "frontend"],
  "permissions": [
    "core:default",
    "core:window:allow-is-visible",
    "core:window:allow-is-focused",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-set-title",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-outer-size",
    "core:window:allow-current-monitor",
    "core:window:allow-primary-monitor",
    "global-shortcut:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "allow-scan-games",
    "allow-scan-apps",
    "allow-launch-item",
    "allow-running-games",
    "allow-quit-game",
    "allow-cache-covers",
    "allow-steam-library-cover",
    "allow-autostart-enabled",
    "allow-set-autostart",
    "allow-fse-status",
    "allow-register-fse",
    "allow-open-fse-settings",
    "allow-open-desktop",
    "allow-enter-fullscreen",
    "allow-system-power",
    "allow-quit-launcher",
    "allow-set-locale",
    "allow-toggle-frontend",
    "allow-open-frontend",
    "allow-close-frontend",
    "allow-focus-frontend",
    "allow-tdp-status",
    "allow-set-tdp",
    "allow-toolbox-runtimes",
    "allow-toolbox-install-runtime",
    "allow-toolbox-optiscaler-installed",
    "allow-toolbox-install-optiscaler",
    "allow-toolbox-tdp-driver-status",
    "allow-toolbox-install-tdp-driver",
    "allow-file-places",
    "allow-file-list",
    "allow-file-make-dir",
    "allow-file-make-file",
    "allow-file-copy",
    "allow-file-move",
    "allow-file-delete",
    "allow-file-read-text",
    "allow-file-write-text",
    "allow-file-icon",
    "allow-file-open"
  ]
}
