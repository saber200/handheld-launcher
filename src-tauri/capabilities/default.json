{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for FantasyHub",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-set-title",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "allow-scan-games",
    "allow-scan-apps",
    "allow-launch-item",
    "allow-running-games",
    "allow-quit-game",
    "allow-cache-covers",
    "allow-steam-library-cover",
    "allow-autostart-enabled",
    "allow-set-autostart",
    "allow-fse-status",
    "allow-register-fse",
    "allow-open-desktop",
    "allow-enter-fullscreen",
    "allow-system-power",
    "allow-quit-launcher",
    "allow-set-locale",
    "allow-file-places",
    "allow-file-list",
    "allow-file-make-dir",
    "allow-file-make-file",
    "allow-file-copy",
    "allow-file-move",
    "allow-file-delete",
    "allow-file-read-text",
    "allow-file-write-text",
    "allow-file-icon",
    "allow-file-open"
  ]
}
