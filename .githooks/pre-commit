#!/bin/sh
# 提交前挡住「本机编得过、CI 编不过」这类低级错误 —— v0.1.46 连挂两轮 CI
# （stale 的 normalize_win_path、重复的 set_locale、嵌套 Result）都是这个原因，
# 每一轮都要等 20 分钟才知道。
#
# 装一次（每个克隆各一次）：npm run hooks
# 手动跳过：git commit --no-verify
#
# 只检查这次提交碰过的语言：没碰 Rust 就不编 Rust，没碰前端就不跑 tsc。
# 用的是和 CI 同名的命令（clippy --workspace --all-targets / tsc --noEmit），
# 所以本地绿 == CI 的编译阶段绿；all-targets 连测试代码一起编，这一点比发布流程更严。
set -u

root=$(git rev-parse --show-toplevel) || exit 0
cd "$root" || exit 0

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit 0

# 命令权限审计：前端 invoke 的每个命令都要「注册进 invoke_handler → 有 permission allow →
# capability 引用」三步齐全，少一步在真机上就是被 ACL 静默拒掉（v0.1.62 的「存储空间
# 一直待接入」就是这个）。纯文本扫描、毫秒级，所以每次都跑。
if printf '%s\n' "$staged" | grep -qE '\.(ts|tsx|rs|toml|json)$'; then
  # OTA 的配置错误几乎都是静默的（发版照样绿、应用照样起，只是更新永远查不到/装不上），
  # 所以和 acl 一样放进提交前这道闸。
  echo "[pre-commit] node scripts/audit-ota.mjs"
  node scripts/audit-ota.mjs || {
    echo "[pre-commit] OTA 配置没过 —— 见上面每一条 ❌（它们都会让更新静默失效）。"
    exit 1
  }

  echo "[pre-commit] node scripts/audit-acl.mjs"
  node scripts/audit-acl.mjs || {
    echo "[pre-commit] 命令权限审计没过，提交已拦下。" >&2
    exit 1
  }
fi

if printf '%s\n' "$staged" | grep -qE '\.(ts|tsx|html)$'; then
  echo "[pre-commit] tsc --noEmit"
  npx tsc --noEmit || {
    echo "[pre-commit] 前端类型检查没过，提交已拦下。" >&2
    exit 1
  }
fi

# 界面规范：禁胶囊 / 禁椭圆 / 颜色与设计令牌对表（改造包 §14；那三个 .py 依赖设计工具
# 内部模块，包里没带，改用零依赖的 scripts/audit-ui.mjs）。
if printf '%s\n' "$staged" | grep -qE '\.(css|tsx|ts)$'; then
  echo "[pre-commit] node scripts/audit-ui.mjs"
  node scripts/audit-ui.mjs || {
    echo "[pre-commit] 界面规范审计没过，提交已拦下。" >&2
    exit 1
  }
fi

if printf '%s\n' "$staged" | grep -qE '(^|/)Cargo\.(toml|lock)$|\.rs$'; then
  echo "[pre-commit] cargo clippy --workspace --all-targets"
  out=$(cargo clippy --workspace --all-targets 2>&1)
  code=$?
  # 告警按类别汇总，不刷屏（本机编不到 Windows 专属代码，那批 dead_code 告警很正常）。
  printf '%s\n' "$out" | grep -E '^(warning|error)' | sort | uniq -c | sort -rn | head -15
  if [ "$code" -ne 0 ]; then
    printf '%s\n' "$out" | grep -E '^error' -A 6 | head -60 >&2
    echo "[pre-commit] Rust 编译/检查没过，提交已拦下。" >&2
    exit 1
  fi
fi

exit 0
